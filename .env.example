# ==============================================================
# EMPLOYEE RECORDS MANAGEMENT SYSTEM (ERMS) - ENVIRONMENT TEMPLATE
# ==============================================================
# Copy this file to .env for local overrides.
# DO NOT commit sensitive passwords or credentials to source control.

# --- Backend Configuration (ASP.NET Core) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erms_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Full Connection String alternative
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=erms_db;Username=postgres;Password=your_secure_password_here

# --- Frontend Configuration (Vite + React) ---
VITE_API_BASE_URL=http://localhost:5000
