# ERMS Backend Environment Variables Template
# Copy this file to .env or set environment variables in your local environment.
# DO NOT commit real secrets or passwords to source control.

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erms_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Connection String Override (Optional, takes precedence if set)
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=erms_db;Username=postgres;Password=your_postgres_password_here

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
